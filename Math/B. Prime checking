#include <bits/stdc++.h>
using namespace std;
#define ll long long
#define nl '\n'
#define George ios_base::sync_with_stdio(false); cin.tie(0);cout.tie(0)
void solve() {
    ll n ;
    cin >> n ;
    if (n == 2 ) {cout << "YES" ; return ;}
    if ( n % 2 == 0 || n < 2 ) {cout << "NO"; return ;}
    for (ll i = 3 ; i * i <= n ; i += 2 ) {
        if (n % i == 0 ) {
            cout << "NO"; return ;
        }
    }
    cout << "YES" ;
}
int main() {
    George;
    int t =1   ;
    //cin >> t;
    while (t--) {

        solve();

    }
}
