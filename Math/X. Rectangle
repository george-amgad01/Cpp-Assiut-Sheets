#include <bits/stdc++.h>
using namespace std;
#define ll long long
#define nl '\n'
#define George ios_base::sync_with_stdio(false); cin.tie(0);cout.tie(0)

void solve() {
    int x1,y1,x2,y2,x3,y3,x4,y4 ;
    cin >> x1 >> y1 >> x2 >> y2 >> x3 >> y3  >> x4 >> y4  ;
    int mn_x = min ({x1,x2,x3,x4})  , mx_x = max ({x1,x2,x3,x4})  ;
    int mn_y = min ({y1,y2,y3,y4})  , mx_y = max ({y1,y2,y3,y4})   ;
    int q ; cin >> q ;
    while (q--) {
        int x , y ; cin >> x >> y ;
        if (x >= mn_x && x <= mx_x && y >= mn_y && y <= mx_y) {
            cout << "YES" << nl ;
        }
        else {
            cout << "NO" << nl ;
        }

    }

}

int main() {
    George;
    int t = 1;
    //cin >> t;
    while (t--) {

        solve() ;
    }
}
