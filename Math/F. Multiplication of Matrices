#include <bits/stdc++.h>
using namespace std;
#define ll long long
#define dd double
#define nl '\n'
#define George ios_base::sync_with_stdio(false); cin.tie(0);cout.tie(0)


void solve () {
    int r1 , c1 ; cin >> r1 >> c1;
    vector<vector<int>> v (r1,vector<int> (c1));

    for (int i = 0 ; i < r1 ; i++) {
        for (int j = 0 ; j < c1 ; j++) {
            cin >> v[i][j];
        }
    }
    int r2 , c2 ; cin >> r2 >> c2;
    vector<vector<int>> v2 (r2,vector<int> (c2));
    for (int i = 0 ; i < r2 ; i++) {
        for (int j = 0 ; j < c2 ; j++) {
            cin >> v2[i][j];
        }
    }


    int row = 0 , col = 0 , res= 0  ;
    vector<vector<int>> ans (r1,vector<int> (c2,0)) ;
    while (row < r1 ) {
        for (int i = 0 ; i < r2 ; i++) {
            res += v[row][i] * v2[i][col];
        }
        ans[row][col] = res;
        res = 0 ;
        col++ ;
        if (col == c2) {
            col = 0 ;
            row++ ; // 0  1
        }
    }

    for (int i = 0 ; i < r1 ; i++) {
        for (int j = 0 ; j < c2 ; j++) {
            cout << ans[i][j] << " " ;
        }
        cout << nl;
    }




}

int main() {
    George;
    int t =1 ;
    //cin >> t;
    while (t--) {
        solve();
    }
}
