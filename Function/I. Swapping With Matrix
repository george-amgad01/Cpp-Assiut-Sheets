#include <bits/stdc++.h>
using namespace std;
#define ll long long
#define nl '\n'
#define George ios_base::sync_with_stdio(false); cin.tie(0);cout.tie(0)

void swapping (ll n, ll x,ll y,vector<vector<ll>>& v ) {
    swap (v[x],v[y]) ;
    for (ll i = 0 ; i < n ; i++) {
        swap(v[i][x],v[i][y]) ;
    }

    for (ll i = 0 ; i < n ; i++) {
        for (ll j = 0 ; j < n ; j++) {
            cout << v[i][j] << " " ;
        }
        cout << nl;
    }
}



int main() {
    George;
    ll n , x, y ;
    cin >> n >> x >> y ;
    x-- ; y-- ;
    vector<vector<ll>> v (n,vector<ll>(n)) ;
    for (ll i = 0 ; i < n ; i++) {
        for (ll j = 0 ; j < n ; j++) {
            cin >> v[i][j];
        }
    }
    int t = 1 ;
    // cin >> t;
    while (t--) {

        swapping (n,x,y, v) ;
    }
}
