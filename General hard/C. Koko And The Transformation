#include <bits/stdc++.h>
using namespace std;
#define ll long long
#define nl '\n'
#define George ios_base::sync_with_stdio(false); cin.tie(0);cout.tie(0)

void solve() {
    ll n , m , res= 0 , res2 = 0 ; cin >> n >> m ;
    vector<ll> a(n);
    vector<ll> b(m);
    for (int i = 0 ; i < n ; ++i) {
        cin >> a[i] ;
        res += a[i] ;
    }
    for (int i = 0 ; i < m ; ++i) {
        cin >> b[i] ;
        res2 += b[i] ;
    }
    if (res == res2 ) cout << "Yes" ;
    else cout << "No" ;

}

int main() {
    George;
    int t = 1 ;
    //cin >> t;
    while (t--) {
        solve() ;
    }
}
