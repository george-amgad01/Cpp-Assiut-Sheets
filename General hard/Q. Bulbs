#include <bits/stdc++.h>
using namespace std;
#define ll long long
#define nl '\n'
#define George ios_base::sync_with_stdio(false); cin.tie(0);cout.tie(0)

void solve() {
    ll n ,cnt = 0 ; cin >> n  ;
    vector<ll> v(n);
    set<ll> s ;
    for(ll i = 0 ; i < n ; i++) cin >> v[i];
    for (int i = 0 ; i < n ; i++) {
        s.insert(v[i]);
        ll last = *s.rbegin();
        if (last == s.size()) {
            cnt++ ;
        }
    }
    cout << cnt ;

}

int main() {
    George;
    int t = 1 ;
    //cin >> t;
    while (t--) {
        solve() ;
    }
}
