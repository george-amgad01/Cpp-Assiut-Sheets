#include <bits/stdc++.h>
using namespace std;
#define ll long long
#define nl '\n'
#define George ios_base::sync_with_stdio(false); cin.tie(0);cout.tie(0)

void solve() {
    ll n , res = 0; cin >> n ;
    vector<ll> a(n);
    vector<ll> freq(1e3+5, 0) ;
    for (ll i = 0 ; i < n ; i++) {
        cin >> a[i] ;
        freq[a[i]]++ ;
    }
    for (int i =0   ; i < n ; i++) {
        if (freq[a[i]+1] > 0 ) {
            res++ ;
        }
    }
    cout << res ;

}

int main() {
    George;
    int t = 1 ;
    //cin >> t;
    while (t--) {

        solve() ;
    }
}
