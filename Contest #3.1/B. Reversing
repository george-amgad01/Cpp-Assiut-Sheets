#include <bits/stdc++.h>
using namespace std;
#define ll long long
#define nl '\n'
#define George ios_base::sync_with_stdio(false); cin.tie(0);cout.tie(0)

void solve() {
    ll n ; cin >> n ;
    vector<ll> a(n);
    for (ll i = 0 ; i < n ; i++) {
        cin >> a[i] ;
    }
    for (int i = 0 ; i < n ; i++) {
        if (a[i] == 0) {
            reverse(a.begin() , a.begin() + i );
        }
    }
    for (ll i = 0 ; i < n ; i++) {
        cout << a[i] << " ";
    }
}

int main() {
    George;
    int t = 1 ;
    //cin >> t;
    while (t--) {

        solve() ;
    }
}
