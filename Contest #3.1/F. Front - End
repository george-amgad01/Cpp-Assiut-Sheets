#include <bits/stdc++.h>
using namespace std;
#define ll long long
#define nl '\n'
#define George ios_base::sync_with_stdio(false); cin.tie(0);cout.tie(0)

void solve() {
   ll n ; cin >> n ;
    ll l = 0 , r = n -1 ;
    vector<ll> a(n);
    for (ll i = 0 ; i < n ; i++) cin >> a[i];
    if (n == 1 ) {cout << a[0] ;return;}
    while (l <= r) {
        if (l == r ) {cout << a[l] ; return;}
        cout << a[l] << " " << a[r] << " ";
        l++ ;
        r-- ;
    }

}

int main() {
    George;
    int t = 1;
    //cin >> t;
    while (t--) {

        solve() ;
    }
}
