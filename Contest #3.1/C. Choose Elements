#include <bits/stdc++.h>
using namespace std;
#define ll long long
#define nl '\n'
#define George ios_base::sync_with_stdio(false); cin.tie(0);cout.tie(0)

void solve() {
    ll n , k , res = 0 ; cin >> n  >> k ;
    vector<ll> a(n);
    for (ll i = 0 ; i < n ; i++) {
        cin >> a[i] ;
    }
    sort(a.begin(), a.end(),greater<ll>() );
    for (int i =0   ; i < k ; i++) {
        if (a[i] > 0 ) {
            res += a[i];
        }
    }
    cout << res ;

}

int main() {
    George;
    int t = 1 ;
    //cin >> t;
    while (t--) {

        solve() ;
    }
}
