#include <bits/stdc++.h>
using namespace std;
#define ll long long
#define nl '\n'
#define George ios_base::sync_with_stdio(false); cin.tie(0);cout.tie(0)

void solve() {
    ll n ;
    cin >> n ;
    vector<ll> v (n) ;
    for (ll i = 0 ; i < n; ++i ) {
        cin >> v[i] ;
    }
    ll mn = v[0] , mx = v[n-1] , dif = 0 , dif2 = 0 ;
    for (ll i = 0 ; i < n  ; ++i ) {
        if (i == 0) {
            dif = abs(mn - v[i+1]) ;
            dif2 = abs(mn - mx) ;
            cout << dif << " " << dif2 << nl;
        }
        else if (i == n-1 ) {
            dif = abs(mx - v[i-1]) ;
            dif2 = abs(mx - mn) ;
            cout << dif << " " << dif2 << nl;
        }

        else {
            dif = min (abs(v[i] - v[i+1]), abs(v[i] - v[i-1])) ;
            dif2 = max (abs(v[i] - mx), abs(v[i] - mn)) ;
            cout << dif << " " << dif2 << nl;
        }
    }
}


int main() {
    George;

    int t = 1 ;
    // cin >> t;
    while (t--) {
        solve();
    }
}
