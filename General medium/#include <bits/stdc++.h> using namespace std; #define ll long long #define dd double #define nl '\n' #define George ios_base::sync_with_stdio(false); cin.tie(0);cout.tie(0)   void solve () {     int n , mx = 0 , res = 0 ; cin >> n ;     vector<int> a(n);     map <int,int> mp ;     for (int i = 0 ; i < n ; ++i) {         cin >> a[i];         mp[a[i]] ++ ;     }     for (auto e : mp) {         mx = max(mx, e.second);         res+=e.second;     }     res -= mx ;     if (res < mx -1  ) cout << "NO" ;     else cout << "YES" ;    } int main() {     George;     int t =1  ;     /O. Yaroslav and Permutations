#include <bits/stdc++.h>
using namespace std;
#define ll long long
#define dd double
#define nl '\n'
#define George ios_base::sync_with_stdio(false); cin.tie(0);cout.tie(0)


void solve () {
    int n , mx = 0 , res = 0 ; cin >> n ;
    vector<int> a(n);
    map <int,int> mp ;
    for (int i = 0 ; i < n ; ++i) {
        cin >> a[i];
        mp[a[i]] ++ ;
    }
    for (auto e : mp) {
        mx = max(mx, e.second);
        res+=e.second;
    }
    res -= mx ;
    if (res < mx -1  ) cout << "NO" ;
    else cout << "YES" ;



}
int main() {
    George;
    int t =1  ;
    // cin >> t;
    while (t--) {
        solve();
    }
}
