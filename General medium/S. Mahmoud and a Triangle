#include <bits/stdc++.h>
using namespace std;
#define ll long long
#define nl '\n'
#define George ios_base::sync_with_stdio(false); cin.tie(0);cout.tie(0)

void solve() {
    ll n ; cin >> n;
    vector<ll> v(n);
    for(ll i=0;i<n;i++) {
        cin >> v[i];
    }
    sort(v.begin(), v.end());
    for (ll i = 1 ; i < n -1 ; i++) {
        if (v[i] + v[i-1] > v[i+1]) {
            cout << "YES" ;
            return ;
        }
    }
    cout << "NO" ;
}
int main() {
    George;
    int t =1 ;
    //cin >> t;
    while (t--) {
        solve();
    }
}
