#include <bits/stdc++.h>
using namespace std;
#define ll long long
#define nl '\n'
#define George ios_base::sync_with_stdio(false); cin.tie(0);cout.tie(0)
vector<ll> fib ;
bool is_prime(ll n ) {
    if (n == 2 ) { return 1 ;}
    if ( n % 2 == 0 || n < 2 ) { return 0 ;}
    for (ll i = 3 ; i * i <= n ; i += 2 ) {
        if (n % i == 0 ) {
            return 0 ;
        }
    }
    return 1 ;
}

void solve() {
    ll a= 0 , b = 1 , c = 0 ;
    fib.push_back(a);
    fib.push_back(b);
    for (ll i = 3; i <= 50 ; i++) {
        c = b + a ;
        fib.push_back(c) ;
        a = b ;
        b = c ;
    }
    for (ll i = 0 ; i < fib.size() ; i++) {
        if (is_prime(fib[i]) ) {
            fib[i] = 1 ;
        }
        else {
            fib[i] = 0 ;
        }
    }

}


int main() {
    George;
    solve();
    int t ;
    cin >> t;
    while (t--) {
        ll n ; cin >> n ;
        if (fib[n-1] ==1 ) {
            cout << "prime" << nl ;
        }
        else {
            cout << "not prime" << nl ;
        }

    }
}
